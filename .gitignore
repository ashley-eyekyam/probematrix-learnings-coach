# analysis workspaces and outputs
ws/
pmlc-*/
outputs/
!samples/*/outputs/
*-workspace/
# never commit raw or unsanitised exports outside samples/
*.xlsx
!samples/**/*.xlsx
!docs/uat/inputs/uat-*.xlsx
~$*
# converted documents may carry author metadata: keep them out unless published as a sample or brief
*.pdf
*.docx
*.pptx
!samples/**/*.pdf
!samples/**/*.docx
!samples/**/*.pptx
!docs/briefs/**/*.pdf
!docs/briefs/**/*.docx
!docs/briefs/**/*.pptx
# python
__pycache__/
*.pyc
.pytest_cache/
.venv/
# os
.DS_Store
# internal briefs (not for the public repo)
docs/briefs/outreach-engine-improvement-prompt.md
docs/briefs/reference-adhoc-render-script.py
.coverage
.coverage.*

# Office lock files
.~lock.*#
