{
  "_about": "Editable rules that map the free-text 'Individuals Involved' roles in a ProbeMatrix findings export to the Learnings Coach organisational taxonomy. F = functional entity (who owns the learning), T = organisational tier (which level learns), R = relation of the role to the factor. Regexes are case-insensitive. A role may belong to several F entities (all matching rules apply, minus 'exclude'). T and R take the first match. Roles that match nothing are listed for an LLM resolution pass (see skills/learning-clusters).",
  "entities": [
    {"id": "F01", "name": "Operations & Control Room", "match": "operat|control[- ]room|\\bshift\\b|shift[- ]in[- ]?charge|chief engineer \\(production\\)|junior engineer|production|\\bcr\\b|panel engineer|process operator"},
    {"id": "F02", "name": "Mechanical Maintenance", "match": "mainten|fitter|technician|gasket|mechanic|crew", "exclude": "electric|fire[- ]?water|instrument|calibrat|planner|planning"},
    {"id": "F03", "name": "Electrical Maintenance", "match": "electric|\\bflp\\b|lamp|lighting"},
    {"id": "F04", "name": "Instrumentation, Control & Calibration", "match": "calibrat|instrument|\\bdcs\\b|control system|\\bi&c\\b|automation|f&g|fire and gas detect|metering"},
    {"id": "F05", "name": "Asset Integrity, Corrosion & Inspection", "match": "integrit|corrosion|inspection|pipeline|\\but\\b|thickness|reliabilit|ndt"},
    {"id": "F06", "name": "Materials Management (Stores / Procurement)", "match": "stores|procure|materials? manag|purchas|spares|quality control"},
    {"id": "F07", "name": "Engineering, Design, Documents & MOC", "match": "engineering (manager|management|authority|decision|document|data)|engineering/|technical authority|design|draught|drafting|document|drawing|p&id|\\bmoc\\b|management of change|change review|configuration|records|commissioning|facilities engineering"},
    {"id": "F08", "name": "Work Management & Planning", "match": "planner|\\bsap\\b|notification|work[- ]order|work[- ]management|maintenance planning|planning (lead|supervis|staff)"},
    {"id": "F09a", "name": "Fire-fighting Operations & Fire-water Systems", "match": "fire[- ]?fight|fire[- ]?water|fire station|fire (crew|team|service|chief|officer)|fire pump|fire and safety|fire & safety"},
    {"id": "F09b", "name": "Emergency Planning & Command", "match": "erdmp|\\bdmp\\b|drill|\\bsic\\b|\\bcic\\b|incident (control|command)|emergenc|crisis"},
    {"id": "F10", "name": "Security & Surveillance", "match": "cisf|cctv|watch[- ]?tower|security|constable|sub-inspector|guard"},
    {"id": "F11", "name": "HSE, Process Safety & Audit", "match": "\\bhse\\b|\\bh&s\\b|safety|audit|permit|health & safety"},
    {"id": "F12", "name": "HR, Training & Competence", "match": "\\bhr\\b|human resource|training|competen|roster|manning|staffing|qualif|recruit"},
    {"id": "F13", "name": "Plant & Asset Leadership", "match": "plant manag|plant management|head operations|site manag|area manag|asset manag|resident engineer|superintendent|asset owner|leadership|general manager|\\bgm\\b|\\bcgm\\b"},
    {"id": "F14", "name": "Corporate, External & Vendors", "match": "director|corporate|vendor|supplier|\\boem\\b|contractor|recommendation-tracking|regulator|board"}
  ],
  "tiers": [
    {"id": "T5", "name": "Corporate / policy owner / board", "match": "policy|corporate|director|board|governance|programme owner|program owner|hr/"},
    {"id": "T4", "name": "Plant / asset leadership", "match": "plant manag|plant management|head operations|\\bcgm\\b|\\bgm\\b|\\bcic\\b|\\bsic\\b|resident engineer|site manag|leadership|superintendent|asset owner"},
    {"id": "T3", "name": "Function / department management", "match": "manag|\\bhead\\b|authority|\\blead\\b|owner|custodian|approver|decision-maker|programme|program"},
    {"id": "T2", "name": "First-line supervision / shift in-charge", "match": "supervis|in-?charge|\\bdgm\\b|chief engineer|signatory|permit issu|coordinator|controller|planner|team lead|leader|senior officer|foreman"},
    {"id": "T1", "name": "Frontline / sharp end", "match": "fitter|technician|operator|crew|constable|sub-inspector|junior engineer|team|personnel|staff|members|engineers?\\b|draughtsman|requestor|requester|raiser|learners|worker"}
  ],
  "relations": [
    {"id": "approver", "name": "approver / authoriser", "match": "approv|authoris|authoriz|sign|acceptance|accepted|accepting|return-to-service|closure"},
    {"id": "owner", "name": "owner / custodian", "match": "owner|custodian|responsible for|policy"},
    {"id": "absent", "name": "absent / not provided", "match": "absent|not provided|implicit"},
    {"id": "norm_setter", "name": "role model / norm-setter", "match": "role model|modelled|demonstrating|\\bnorm\\b"},
    {"id": "learner", "name": "learner / norm-receiver", "match": "learner|learning the"},
    {"id": "challenger", "name": "expected challenger", "match": "should have challenged|challenge"}
  ],
  "default_relation": {"id": "actor", "name": "actor / participant"}
}
