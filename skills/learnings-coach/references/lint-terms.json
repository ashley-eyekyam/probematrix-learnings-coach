{
 "version": 1,
 "_about": "check-language (pmlc_lint.py) rules JC1-JC12. Patterns are Python regular expressions, matched case-insensitively unless the rule says \"case\": \"sensitive\". 'allow' phrases clear a hit inside them. 'name_vocabulary' words exempt a pair of capitalised words from JC1 (P2-4).",
 "rules": {
  "JC1": {
   "severity": "error",
   "patterns": [],
   "hint": "use the role, not the person, e.g. \"the fitter\" or \"the shift supervisor\"; if this is not a person, add lint_ok with the reason"
  },
  "JC2": {
   "severity": "error",
   "patterns": [
    "(?<![\\w-])disciplin(?:e|ed|ary)\\b",
    "\\bcareless(?:ly|ness)?\\b",
    "\\breckless(?:ly|ness)?\\b",
    "\\b(?:hold|holds|holding|held)\\b.{0,30}?\\baccountable\\b",
    "\\bconsequences\\b",
    "\\bpunish\\w*",
    "\\bperformance (?:review|appraisal)s?\\b"
   ],
   "hint": "describe what the organisation will change so the work is safer (a check, a design change, a resourced task), not a sanction"
  },
  "JC3": {
   "severity": "warning",
   "patterns": [
    "\\bfailed to\\b",
    "\\bshould have\\b",
    "\\bwould have\\b",
    "\\bcould have prevented\\b"
   ],
   "hint": "say what was not done and what the system did not require or support"
  },
  "JC4": {
   "severity": "warning",
   "patterns": [
    "\\bobvious(?:ly)?\\b",
    "\\bclearly should\\b",
    "\\bsimply needed to\\b"
   ],
   "hint": "describe what was knowable at the time and why the action made sense then"
  },
  "JC5": {
   "severity": "warning",
   "patterns": [
    "\\bbreach(?:es|ed)?\\b",
    "\\bnegligen\\w*",
    "\\bliable\\b",
    "\\bfailed to comply\\b",
    "\\bnon-compliant with\\b",
    "\\billegal\\b",
    "\\bunlawful\\b",
    "\\bdeficien\\w*"
   ],
   "hint": "describe the gap against the requirement (\"the procedure did not require X\") and leave legal conclusions to the competent authority"
  },
  "JC6": {
   "severity": "warning",
   "patterns": [],
   "hint": "the cited cause sits at level 3 or 4: add a change at its level (engineering, substitution, elimination, or a resourced organisational change), not training or procedure alone"
  },
  "JC7": {
   "severity": "warning",
   "patterns": [],
   "hint": "this role has one holder, so it points to a person: use the generalised role label"
  },
  "JC8": {
   "severity": "warning",
   "patterns": [
    "\\b\\d+(?:\\.\\d+)?\\s?%",
    "\\b\\d+(?:\\.\\d+)?\\s?(?:seconds?|min(?:ute)?s?|hours?|hrs?|days?|weeks?|months?|years?)\\b"
   ],
   "hint": "cite the record that gives this number, or take it out; add no outside facts"
  },
  "JC9": {
   "severity": "warning",
   "case": "sensitive",
   "patterns": [
    "\\b(?:[A-Z][\\w&'-]*\\s+){1,4}(?:Ltd|Pvt|Inc|GmbH|LLC|Limited)\\b\\.?"
   ],
   "hint": "name the organisation by its function, e.g. \"the operator\" or \"the seal supplier\""
  },
  "JC10": {
   "severity": "warning",
   "patterns": [],
   "hint": "describe the equipment generically, e.g. \"the condensate meter\", before sharing outside"
  },
  "JC11": {
   "severity": "error",
   "patterns": [],
   "hint": "must contain \"Learning purposes: not a statutory document\""
  },
  "JC12": {
   "severity": "warning",
   "patterns": [
    "\\bbe (?:more )?careful\\b",
    "\\bpay (?:more )?attention\\b",
    "\\bstay vigilant\\b",
    "\\bremain alert\\b",
    "\\btake ownership\\b"
   ],
   "hint": "replace the appeal with a change to the work: a check, a hold point, an alarm or a tool"
  }
 },
