    "item_table": {
      "type": "object",
      "required": [
        "kind",
        "columns",
        "rows"
      ],
      "properties": {
        "kind": {
          "const": "table"
        },
        "columns": {
          "$ref": "#/$defs/text_list"
        },
        "rows": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "array",
